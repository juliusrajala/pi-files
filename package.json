{
  "name": "pi-files",
  "private": true,
  "version": "0.1.0",
  "description": "Personal Pi extensions, skills, prompts, and themes",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:pi-version": "node scripts/check-pi-version.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "25.0.3",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  }
}
